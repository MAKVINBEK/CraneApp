{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --omit=dev && node -e \"require('express'); require('bcrypt'); require('bcryptjs'); require('sharp')\""
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "node --max-old-space-size=512 server/gateway/apiGateway.js",
    "healthcheckPath": "/api/v2/health",
    "healthcheckTimeout": 120,
    "healthcheckInterval": 15
  }
}
