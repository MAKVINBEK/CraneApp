        const chatTextUtils = window.CraneChatTextUtils.create({
            getActiveChat: () => activeChat,
            getChatUsers: () => chatUsers,
            pluralMembers: (count) => pluralMembers(count),
        });
        const {
            chatStatusText,
            formatI18n,
