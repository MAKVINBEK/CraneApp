        }

        function updateContextMenuReactions(messageId) {
            reactionController.updateContextMenuReactions(messageId);
        }

        function updateMessageReactions(messageId, reactions) {
            reactionController.updateMessageReactions(messageId, reactions);
        }

        function showReactionPicker(e, messageId) {
            reactionController.showReactionPicker(e, messageId);
        }

        function showFullEmojiPicker(messageId) {
            reactionController.showFullEmojiPicker(messageId);
        }

        function closeReactionPicker() {
            reactionController.closeReactionPicker();
        }

        function closeFullEmojiPicker() {
