<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>астройки - CraneApp</title>
    <script src="../../scripts/theme.js"></script>
    <script src="../../scripts/i18n.js"></script>
    <style>
        :root {
            --bg-primary: #000000; --bg-secondary: #121212; --bg-tertiary: #1E1E1E;
            --text-primary: #FFFFFF; --text-secondary: #B0B0B0; --text-muted: #666666;
            --border-color: #1E1E1E; --safe-area-top: env(safe-area-inset-top, 0px);
            --accent-color: #FF007F; --accent-gradient: linear-gradient(135deg, #FF007F, #9D00FF);
            --safe-area-bottom: env(safe-area-inset-bottom, 0px);
        }
        [data-theme="light"] {
            --bg-primary: #FFFFFF; --bg-secondary: #F5F5F5; --bg-tertiary: #EEEEEE;
            --text-primary: #000000; --text-secondary: #666666; --text-muted: #999999;
            --border-color: #DDDDDD;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html, body { height: 100%; min-height: 100vh; background: var(--bg-primary); }
        body {
            background-color: var(--bg-primary); color: var(--text-primary);
            font-family: system-ui, -apple-system, sans-serif; font-size: 14px;
            padding-top: var(--safe-area-top); -webkit-user-select: none; user-select: none;
        }
        .app-wrapper {
            width: 100%; display: flex; flex-direction: column; min-height: 100vh;
            background: var(--bg-primary); padding-bottom: calc(70px + var(--safe-area-bottom));
        }
        @media (min-width: 768px) {
            .app-wrapper { padding-bottom: 30px; }
            .tab-bar { display: none !important; }
            .pc-header-menu { display: flex !important; }
            .mobile-back-btn { display: none !important; }
            .logout-btn-mobile { display: none !important; }
        }
        @media (max-width: 767px) {
            .pc-header-menu { display: none !important; }
            .mobile-back-btn { display: block !important; }
        }
        .header {
            padding: 10px 12px; background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 100;
        }
        @media (min-width: 768px) { .header { padding: 16px 32px; } }
        .header-left { display: flex; align-items: center; gap: 8px; }
        .back-btn {
            background: none; border: none; color: var(--text-primary); font-size: 22px;
            cursor: pointer; width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
        }
        .back-btn:active { background: rgba(255,255,255,0.1); }
        .header-title { font-size: 17px; font-weight: 700; }
        @media (min-width: 768px) { .header-title { font-size: 22px; } }
        .header-btn {
            background: none; border: none; color: var(--text-primary); font-size: 18px;
            cursor: pointer; width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
        }
        .sync-indicator { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
        .sync-indicator.syncing { color: var(--accent-color); }
        .sync-indicator.synced { color: #00FF88; }
        .profile-section {
            padding: 16px 12px;
            background: linear-gradient(180deg, rgba(255,0,127,0.1) 0%, transparent 100%);
            display: flex; align-items: center; gap: 12px; cursor: pointer;
        }
        @media (min-width: 768px) { .profile-section { padding: 32px; gap: 20px; } }
        .profile-avatar {
            width: 56px; height: 56px; border-radius: 50%;
            background: var(--accent-gradient); display: flex; align-items: center;
            justify-content: center; font-size: 22px; font-weight: 700; color: #FFF;
            flex-shrink: 0; overflow: hidden;
        }
        @media (min-width: 768px) { .profile-avatar { width: 80px; height: 80px; font-size: 32px; } }
        .profile-avatar:active { transform: scale(0.97); }
        .profile-avatar-img { width: 100%; height: 100%; object-fit: cover; }
        .profile-info { flex: 1; overflow: hidden; }
        .profile-name { font-size: 17px; font-weight: 700; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        @media (min-width: 768px) { .profile-name { font-size: 24px; } }
        .profile-username { font-size: 13px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .profile-status { font-size: 12px; color: #00FF00; margin-top: 2px; }
        .profile-bio { font-size: 12px; color: var(--text-muted); margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .settings-group {
            background: var(--bg-secondary); margin: 10px 8px; border-radius: 12px; overflow: hidden;
        }
        @media (min-width: 768px) { .settings-group { margin: 16px 32px; border-radius: 16px; } }
        .settings-item {
            display: flex; align-items: center; padding: 12px; cursor: pointer;
            border-bottom: 1px solid var(--border-color); text-decoration: none;
            color: inherit; transition: background 0.15s;
        }
        @media (min-width: 768px) { .settings-item { padding: 18px 24px; } }
        .settings-item:last-child { border-bottom: none; }
        .settings-item:active { background: var(--bg-tertiary); }
        .settings-icon {
            width: 34px; height: 34px; border-radius: 10px; display: flex;
            align-items: center; justify-content: center; font-size: 15px;
            margin-right: 10px; flex-shrink: 0;
        }
        @media (min-width: 768px) { .settings-icon { width: 44px; height: 44px; font-size: 20px; margin-right: 16px; } }
        .settings-label { flex: 1; font-size: 14px; }
        @media (min-width: 768px) { .settings-label { font-size: 17px; } }
        .settings-value { color: var(--text-secondary); font-size: 12px; margin-right: 6px; }
        @media (min-width: 768px) { .settings-value { font-size: 15px; } }
        .settings-arrow { color: var(--text-muted); font-size: 16px; }
        .logout-btn {
            width: calc(100% - 16px); margin: 8px; padding: 14px; border-radius: 12px;
            border: none; background: linear-gradient(135deg, #FF4B4B, #FF007F);
            color: #FFF; font-size: 14px; font-weight: 600; cursor: pointer;
        }
        @media (min-width: 768px) { .logout-btn { width: calc(100% - 64px); margin: 0 32px 32px; padding: 18px; font-size: 17px; border-radius: 16px; } }
        .logout-btn:active { opacity: 0.85; }
        .tab-bar {
            height: 56px; background: var(--bg-secondary); border-top: 1px solid var(--border-color);
            display: flex; justify-content: space-around; align-items: center;
            position: fixed; bottom: 0; left: 0; right: 0; padding-bottom: var(--safe-area-bottom);
        }
        .tab-item { display: flex; flex-direction: column; align-items: center; gap: 2px; cursor: pointer; color: var(--text-muted); padding: 4px 12px; }
        .tab-item.active { color: var(--accent-color); }
        .tab-icon { font-size: 20px; }
        .tab-label { font-size: 10px; }
        .dropdown-menu {
            position: absolute; top: 50px; right: 12px; background: var(--bg-tertiary);
            border-radius: 12px; padding: 6px 0; box-shadow: 0 8px 32px rgba(0,0,0,0.5);
            z-index: 1000; display: none; min-width: 180px;
        }
        @media (min-width: 768px) { .dropdown-menu { right: 32px; top: 60px; } }
        .dropdown-menu.show { display: block; }
        .dropdown-item { padding: 12px 14px; display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; }
        .dropdown-item:active { background: var(--bg-secondary); }
        .dropdown-item.danger { color: #FF4B4B; }
        .toast-container {
            position: fixed; bottom: calc(70px + var(--safe-area-bottom));
            left: 12px; right: 12px; z-index: 10002;
            display: flex; flex-direction: column; gap: 6px; pointer-events: none;
        }
        @media (min-width: 768px) { .toast-container { left: 32px; right: 32px; bottom: 32px; } }
        .toast {
            padding: 10px 14px; background: var(--bg-secondary); border-radius: 10px;
            display: flex; align-items: center; gap: 8px; animation: slideIn 0.3s ease;
            border-left: 4px solid var(--accent-color); box-shadow: 0 4px 20px rgba(0,0,0,0.3); font-size: 13px;
        }
        .toast.success { border-left-color: #00FF88; }
        .toast.error { border-left-color: #FF4B4B; }
        @keyframes slideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div class="toast-container" id="toastContainer"></div>
    <div class="app-wrapper">
        <div class="header">
            <div class="header-left">
                <button class="back-btn mobile-back-btn" onclick="goToChats()">&#8592;</button>
                <span class="header-title">астройки</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <div class="sync-indicator" id="syncIndicator">
                    <span id="syncIcon">&#x1F504;</span>
                    <span id="syncText">Синхронизация...</span>
                </div>
                <button class="header-btn pc-header-menu" id="pcMenuBtn">&#8942;</button>
            </div>
        </div>
        <div class="dropdown-menu" id="pcDropdown">
            <div class="dropdown-item" onclick="location.href='./editProfile.html'"><span>&#9999;</span><span>зменить профиль</span></div>
            <div class="dropdown-item" onclick="syncNow()"><span>&#x1F504;</span><span>Синхронизировать</span></div>
            <div class="dropdown-item danger" id="pcLogoutBtn"><span>&#x1F6AA;</span><span>ыйти из аккаунта</span></div>
        </div>
        <div class="profile-section" onclick="location.href='./editProfile.html'">
            <div class="profile-avatar" id="profileAvatar"><span>&#x1F464;</span></div>
            <div class="profile-info">
                <div class="profile-name" id="profileName">агрузка...</div>
                <div class="profile-username" id="profileUsername">@username</div>
                <div class="profile-bio" id="profileBio"></div>
                <div class="profile-status">онлайн</div>
            </div>
        </div>
